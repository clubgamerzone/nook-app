# Copy this file to android/keystore.properties and replace every placeholder.
# android/keystore.properties and *.keystore are ignored by Git.
# Use forward slashes in Windows paths.
storeFile=C:/Users/YOUR_WINDOWS_USER/.nook-signing/nook-upload.keystore
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=nook-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
